# OpenAI API key — required for transcript generation (--model OpenAI) and TTS audio
OPENAI_API_KEY=sk-...

# ElevenLabs API key — required for scripts/test_elevenlabs.py
ELEVENLABS_API_KEY=...

# Google Gemini API key — required for transcript generation (--model Gemini)
GEMINI_API_KEY=...

# AWS credentials — required for S3 upload (rss and archive stages)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

ABE_VOICE_ID=...                # ElevenLabs voice ID for Abe
BAILEY_VOICE_ID=...             # ElevenLabs voice ID for Bailey
LLM_TEMPERATURE=0.7             # LLM creativity (default: 0.7)
ELEVENLABS_MODEL=eleven_v3      # ElevenLabs TTS model (default: eleven_v3)
AUDIO_CHUNK_SIZE=1900           # Max chars per ElevenLabs API call (default: 1900)
PAUSE_DURATION_MS=1000          # Silence length for [PAUSE] markers in ms (default: 1000)
AUDIO_SEED=42                   # Shared seed across ElevenLabs calls to reduce cross-chunk voice drift (default: 42)
RSS_MAX_EPISODES=7              # Episodes to retain in RSS feed (default: 7)
