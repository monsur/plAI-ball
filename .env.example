# OpenAI API key — required for transcript generation (--model OpenAI) and TTS audio
OPENAI_API_KEY=sk-...

# Google Gemini API key — required for transcript generation (--model Gemini)
GEMINI_API_KEY=...

# AWS credentials — required for S3 upload (rss and archive stages)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
