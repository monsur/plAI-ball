# Secrets only. Non-secret tunables (voice IDs, temperatures, chunk sizes,
# retention) live in config.toml at the repo root.

# OpenAI API key — required for transcript generation (--model OpenAI) and
# audio generation (gpt-4o-mini-tts)
OPENAI_API_KEY=sk-...

# Google Gemini API key — required for transcript generation (--model Gemini)
GEMINI_API_KEY=...

# AWS credentials — required for S3 upload (rss and archive stages)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
